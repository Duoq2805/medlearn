# ============================================
# MEDLEARN BACKEND ENV — copy to .env for docker
# cp backend/.env.example backend/.env
# ============================================

# --- Database ---
POSTGRES_PASSWORD=Medlearn@123
SPRING_DATASOURCE_PASSWORD=Medlearn@123

# --- JWT (REQUIRED — app will NOT boot without it) ---
# Minimum 32 chars. Generate with: openssl rand -base64 48
# Do NOT commit a real secret. Generate your own per environment.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- SMTP (optional for local dev; required for email verify/reset) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Google OAuth2 (optional; leave blank to disable Google login) ---
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# --- AI Gateway (9router.com, OpenAI-compatible) ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://api.9router.com
